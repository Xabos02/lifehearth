# Юнит-тесты (vitest, режим test) НЕ должны доставать до боевого сервера.
# Всё, что в тестах не подменено моком, уходит на этот адрес — и падает сразу,
# вместо того чтобы тихо регистрировать мусорные аккаунты в живой базе.
# Дев-сервер и браузерные тесты берут адрес из .env.development.
VITE_WORKER_URL=http://127.0.0.1:9
